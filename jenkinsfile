pipeline {
    agent any

    tools {
        maven "M3"
    }

    environment {
        DOCKER_IMAGE = "bedhiafixokba/devops"
        DOCKER_TAG = "latest"
        BRANCH_NAME = "OKBA"
        NEXUS_REGISTRY = "localhost:8083"
        NEXUS_MAVEN_URL = "http://localhost:8081/repository/maven-releases/"
        MVN_SETTINGS_ID = "e5e4e28c-e0e0-49da-a6d5-4fd8a607307a"
    }

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'OKBA', description: 'Branch to build')
        string(name: 'DOCKER_TAG', defaultValue: 'latest', description: 'Docker image tag')
    }

    stages {
        stage('Git Clone') {
            steps {
                git branch: "${BRANCH_NAME}",
                url: 'https://github.com/skill-exchange-2025/DEVOPS.git'
            }
        }

        stage('Build & Test') {
            steps {
                bat "mvn clean package"
                bat "dir target"
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('scanner') {
                    bat "mvn sonar:sonar -Dsonar.projectKey=DEVOPS"
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                configFileProvider([configFile(fileId: "${MVN_SETTINGS_ID}", variable: 'MAVEN_SETTINGS')]) {
                    bat "mvn -s %MAVEN_SETTINGS% deploy -DskipTests"
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    docker.build("${NEXUS_REGISTRY}/${DOCKER_IMAGE}:${DOCKER_TAG}")
                }
            }
        }

        stage('Docker Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker') {
                        docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}").push()
                    }
                }
            }
        }

        stage('Docker Compose Up') {
            steps {
                bat 'docker-compose down || echo already down'
                bat 'docker-compose up -d --build'
            }
        }

stage('Prometheus Setup') {
    steps {
        script {
            // Wait for Prometheus container to be up without allocating TTY
            bat 'docker exec prom /bin/sh -c "echo Prometheus is up"'
            // You can add more steps here to configure Prometheus if needed
        }
    }
}

stage('Grafana Setup') {
    steps {
        script {
            // Wait for Grafana container to be up without allocating TTY
            bat 'docker exec graf /bin/sh -c "echo Grafana is up"'
            // You can add more steps here to configure Grafana if needed
        }
    }
}


    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
            archiveArtifacts 'target/*.jar'
        }
    }
}
